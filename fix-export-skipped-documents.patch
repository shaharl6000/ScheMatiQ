From 852792d48cc154a64d3c337ff44bf501a8550f85 Mon Sep 17 00:00:00 2001
From: Eliya <eliya@lightricks.com>
Date: Thu, 18 Jun 2026 14:00:39 +0000
Subject: [PATCH] Include skipped_documents in complete JSON export

Skipped documents (with the model's skip reason) are shown in the GUI via
SkippedDocumentsBanner, sourced from session.statistics.skipped_documents,
but were missing from the JSON produced by Export -> Save Project. Add them
to metadata.skipped_documents in all three export builders so the data is
preserved and round-trips through re-import (file_parser already reads
skipped_documents from metadata).

- schematiq route export_complete_schematiq_data
- load route export_complete_data
- data_collection_service _build_project_export_json
---
 backend/app/api/routes/load.py                  | 7 +++++++
 backend/app/api/routes/schematiq.py             | 7 +++++++
 backend/app/services/data_collection_service.py | 7 +++++++
 3 files changed, 21 insertions(+)

diff --git a/backend/app/api/routes/load.py b/backend/app/api/routes/load.py
index 31054b8..6991248 100644
--- a/backend/app/api/routes/load.py
+++ b/backend/app/api/routes/load.py
@@ -1485,6 +1485,13 @@ async def export_complete_data(session_id: str, format: str = "json"):
         if session.statistics and session.statistics.schema_evolution:
             export_data["schema_evolution"] = session.statistics.schema_evolution.model_dump()
 
+        # Include skipped documents if available (parity with the GUI banner)
+        if session.statistics and session.statistics.skipped_documents:
+            export_data["metadata"]["skipped_documents"] = [
+                doc.model_dump() if hasattr(doc, "model_dump") else doc
+                for doc in session.statistics.skipped_documents
+            ]
+
         # Include observation_unit if available
         if session.observation_unit:
             export_data["observation_unit"] = session.observation_unit.model_dump()
diff --git a/backend/app/api/routes/schematiq.py b/backend/app/api/routes/schematiq.py
index 5ff19d6..190d7e6 100644
--- a/backend/app/api/routes/schematiq.py
+++ b/backend/app/api/routes/schematiq.py
@@ -794,6 +794,13 @@ async def export_complete_schematiq_data(
         if session.statistics and session.statistics.schema_evolution:
             export_data["schema_evolution"] = session.statistics.schema_evolution.model_dump()
 
+        # Include skipped documents if available (parity with the GUI banner)
+        if session.statistics and session.statistics.skipped_documents:
+            export_data["metadata"]["skipped_documents"] = [
+                doc.model_dump() if hasattr(doc, "model_dump") else doc
+                for doc in session.statistics.skipped_documents
+            ]
+
         # Include observation_unit if available
         if session.observation_unit:
             export_data["observation_unit"] = session.observation_unit.model_dump()
diff --git a/backend/app/services/data_collection_service.py b/backend/app/services/data_collection_service.py
index 970d963..02637a1 100644
--- a/backend/app/services/data_collection_service.py
+++ b/backend/app/services/data_collection_service.py
@@ -333,6 +333,13 @@ class DataCollectionService:
         if session.statistics and session.statistics.schema_evolution:
             export_data["schema_evolution"] = session.statistics.schema_evolution.model_dump()
 
+        # Include skipped documents if available (parity with the GUI banner)
+        if session.statistics and session.statistics.skipped_documents:
+            export_data["metadata"]["skipped_documents"] = [
+                doc.model_dump() if hasattr(doc, "model_dump") else doc
+                for doc in session.statistics.skipped_documents
+            ]
+
         if session.observation_unit:
             export_data["observation_unit"] = session.observation_unit.model_dump()
 
